// test_aes_ct.mc -- the table-free AES, held to three standards.
//
// The cipher against FIPS-197 appendix C for all three key sizes. The
// cipher against an independent reference written here from the
// standard -- plain table lookups, the textbook shape -- on random keys
// and blocks, which exercises every lane of the circuit with every byte
// value many times over. And GCM against the specification's test case
// 4, so the mode above the cipher is seen to be untouched. The reference
// is itself held to FIPS-197 first, so a mistake in it cannot pass as
// agreement.
//
// Exit 0 means every check held.

@utf8_console

import "../../src/tls/picotls.mc";

i32 fails = 0;

void check(bool ok, str what) {
    if !ok {
        fails++;
        eprint("FAIL: {}\n", what);
    }
}

// --- an independent AES, from the standard ---------------------------------

u8[256] ref_sbox = {
    0x63, 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5, 0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76,
    0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0, 0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0,
    0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc, 0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15,
    0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a, 0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75,
    0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0, 0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84,
    0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b, 0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf,
    0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85, 0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8,
    0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5, 0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2,
    0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17, 0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73,
    0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88, 0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb,
    0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79,
    0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08,
    0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a,
    0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
    0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
    0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16,
};

u8[10] ref_rcon = { 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36 };

u8 xtime(u8 x) {
    u8 hi = cast(u8, x & 0x80);
    u8 y = cast(u8, x << 1);
    if hi != 0 { y = y ^ 0x1b; }
    return y;
}

// Round keys as bytes, word i at rk[4i..4i+4), for nk key words.
void ref_expand(u8* key, i32 nk, u8* rk) {
    i32 nr = nk + 6;
    i32 total = 4 * (nr + 1);
    for i32 i = 0; i < 4 * nk; i++ { *(rk + i) = *(key + i); }
    for i32 i = nk; i < total; i++ {
        u8[4] t;
        for i32 j = 0; j < 4; j++ { t[j] = *(rk + 4 * (i - 1) + j); }
        if i % nk == 0 {
            u8 first = t[0];
            t[0] = ref_sbox[t[1]];
            t[1] = ref_sbox[t[2]];
            t[2] = ref_sbox[t[3]];
            t[3] = ref_sbox[first];
            t[0] = t[0] ^ ref_rcon[i / nk - 1];
        } else if nk > 6 && i % nk == 4 {
            for i32 j = 0; j < 4; j++ { t[j] = ref_sbox[t[j]]; }
        }
        for i32 j = 0; j < 4; j++ { *(rk + 4 * i + j) = *(rk + 4 * (i - nk) + j) ^ t[j]; }
    }
}

// State byte r + 4c is row r, column c; input and output are in that order.
void ref_encrypt(u8* key, i32 nkey, u8* in, u8* out) {
    u8[240] rk;
    i32 nk = nkey / 4;
    i32 nr = nk + 6;
    ref_expand(key, nk, &rk[0]);
    u8[16] s;
    for i32 i = 0; i < 16; i++ { s[i] = *(in + i) ^ rk[i]; }
    for i32 round = 1; round <= nr; round++ {
        u8[16] t;
        for i32 i = 0; i < 16; i++ { t[i] = ref_sbox[s[i]]; }
        for i32 r = 0; r < 4; r++ {
            for i32 c = 0; c < 4; c++ { s[r + 4 * c] = t[r + 4 * ((c + r) % 4)]; }
        }
        if round != nr {
            for i32 c = 0; c < 4; c++ {
                u8 a0 = s[4 * c];
                u8 a1 = s[4 * c + 1];
                u8 a2 = s[4 * c + 2];
                u8 a3 = s[4 * c + 3];
                s[4 * c]     = xtime(a0) ^ (xtime(a1) ^ a1) ^ a2 ^ a3;
                s[4 * c + 1] = a0 ^ xtime(a1) ^ (xtime(a2) ^ a2) ^ a3;
                s[4 * c + 2] = a0 ^ a1 ^ xtime(a2) ^ (xtime(a3) ^ a3);
                s[4 * c + 3] = (xtime(a0) ^ a0) ^ a1 ^ a2 ^ xtime(a3);
            }
        }
        for i32 i = 0; i < 16; i++ { s[i] = s[i] ^ rk[16 * round + i]; }
    }
    for i32 i = 0; i < 16; i++ { *(out + i) = s[i]; }
}

// --- vectors ----------------------------------------------------------------

u64 rng_state = 0x9E3779B97F4A7C15;
u64 rng() {
    rng_state ^= rng_state << 13;
    rng_state ^= rng_state >> 7;
    rng_state ^= rng_state << 17;
    return rng_state;
}

bool same(u8* a, u8* b, i32 n) {
    for i32 i = 0; i < n; i++ { if *(a + i) != *(b + i) { return false; } }
    return true;
}

// FIPS-197 appendix C: one plaintext, three keys.
u8[16] fips_pt = { 0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff };
u8[32] fips_key = { 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
                    0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f };
u8[16] fips_ct128 = { 0x69, 0xc4, 0xe0, 0xd8, 0x6a, 0x7b, 0x04, 0x30, 0xd8, 0xcd, 0xb7, 0x80, 0x70, 0xb4, 0xc5, 0x5a };
u8[16] fips_ct192 = { 0xdd, 0xa9, 0x7c, 0xa4, 0x86, 0x4c, 0xdf, 0xe0, 0x6e, 0xaf, 0x70, 0xa0, 0xec, 0x0d, 0x71, 0x91 };
u8[16] fips_ct256 = { 0x8e, 0xa2, 0xb7, 0xca, 0x51, 0x67, 0x45, 0xbf, 0xea, 0xfc, 0x49, 0x90, 0x4b, 0x49, 0x60, 0x89 };

// GCM test case 4 from the GCM specification: AES-128, a 96-bit IV, twenty
// bytes of associated data, sixty of plaintext.
u8[16] gcm_key = { 0xfe, 0xff, 0xe9, 0x92, 0x86, 0x65, 0x73, 0x1c, 0x6d, 0x6a, 0x8f, 0x94, 0x67, 0x30, 0x83, 0x08 };
u8[12] gcm_iv = { 0xca, 0xfe, 0xba, 0xbe, 0xfa, 0xce, 0xdb, 0xad, 0xde, 0xca, 0xf8, 0x88 };
u8[20] gcm_aad = { 0xfe, 0xed, 0xfa, 0xce, 0xde, 0xad, 0xbe, 0xef, 0xfe, 0xed, 0xfa, 0xce, 0xde, 0xad, 0xbe, 0xef,
                   0xab, 0xad, 0xda, 0xd2 };
u8[60] gcm_pt = { 0xd9, 0x31, 0x32, 0x25, 0xf8, 0x84, 0x06, 0xe5, 0xa5, 0x59, 0x09, 0xc5, 0xaf, 0xf5, 0x26, 0x9a,
                  0x86, 0xa7, 0xa9, 0x53, 0x15, 0x34, 0xf7, 0xda, 0x2e, 0x4c, 0x30, 0x3d, 0x8a, 0x31, 0x8a, 0x72,
                  0x1c, 0x3c, 0x0c, 0x95, 0x95, 0x68, 0x09, 0x53, 0x2f, 0xcf, 0x0e, 0x24, 0x49, 0xa6, 0xb5, 0x25,
                  0xb1, 0x6a, 0xed, 0xf5, 0xaa, 0x0d, 0xe6, 0x57, 0xba, 0x63, 0x7b, 0x39 };
u8[60] gcm_ct = { 0x42, 0x83, 0x1e, 0xc2, 0x21, 0x77, 0x74, 0x24, 0x4b, 0x72, 0x21, 0xb7, 0x84, 0xd0, 0xd4, 0x9c,
                  0xe3, 0xaa, 0x21, 0x2f, 0x2c, 0x02, 0xa4, 0xe0, 0x35, 0xc1, 0x7e, 0x23, 0x29, 0xac, 0xa1, 0x2e,
                  0x21, 0xd5, 0x14, 0xb2, 0x54, 0x66, 0x93, 0x1c, 0x7d, 0x8f, 0x6a, 0x5a, 0xac, 0x84, 0xaa, 0x05,
                  0x1b, 0xa3, 0x0b, 0x39, 0x6a, 0x0a, 0xac, 0x97, 0x3d, 0x58, 0xe0, 0x91 };
u8[16] gcm_tag = { 0x5b, 0xc9, 0x4f, 0xbc, 0x32, 0x21, 0xa5, 0xdb, 0x94, 0xfa, 0xe9, 0x5a, 0xe7, 0x12, 0x1a, 0x47 };

i32 main() {
    u8[16] out;
    cf_aes_context ctx;

    // 1. the reference is itself right
    ref_encrypt(&fips_key[0], 16, &fips_pt[0], &out[0]);
    check(same(&out[0], &fips_ct128[0], 16), "reference: FIPS-197 C.1");
    ref_encrypt(&fips_key[0], 24, &fips_pt[0], &out[0]);
    check(same(&out[0], &fips_ct192[0], 16), "reference: FIPS-197 C.2");
    ref_encrypt(&fips_key[0], 32, &fips_pt[0], &out[0]);
    check(same(&out[0], &fips_ct256[0], 16), "reference: FIPS-197 C.3");

    // 2. the library against FIPS-197
    cf_aes_init(&ctx, &fips_key[0], 16);
    cf_aes_encrypt(&ctx, &fips_pt[0], &out[0]);
    check(same(&out[0], &fips_ct128[0], 16), "FIPS-197 C.1: AES-128");
    cf_aes_init(&ctx, &fips_key[0], 24);
    cf_aes_encrypt(&ctx, &fips_pt[0], &out[0]);
    check(same(&out[0], &fips_ct192[0], 16), "FIPS-197 C.2: AES-192");
    cf_aes_init(&ctx, &fips_key[0], 32);
    cf_aes_encrypt(&ctx, &fips_pt[0], &out[0]);
    check(same(&out[0], &fips_ct256[0], 16), "FIPS-197 C.3: AES-256");

    // 3. the library against the reference: random keys of every size,
    //    random blocks -- every lane of the circuit, every byte value
    i32 mismatches = 0;
    for i32 r = 0; r < 20000; r++ {
        u8[32] key;
        u8[16] pt_in;
        u8[16] a;
        u8[16] b;
        for i32 i = 0; i < 32; i++ { key[i] = cast(u8, rng() & 0xff); }
        for i32 i = 0; i < 16; i++ { pt_in[i] = cast(u8, rng() & 0xff); }
        i32 nkey = 16;
        if r % 3 == 1 { nkey = 24; }
        if r % 3 == 2 { nkey = 32; }
        cf_aes_init(&ctx, &key[0], cast(u64, nkey));
        cf_aes_encrypt(&ctx, &pt_in[0], &a[0]);
        ref_encrypt(&key[0], nkey, &pt_in[0], &b[0]);
        if !same(&a[0], &b[0], 16) { mismatches++; }
    }
    check(mismatches == 0, "the reference agrees on 20000 random blocks");

    // 4. every byte value through the whole cipher, in every position
    for i32 v = 0; v < 256; v++ {
        u8[16] pt_in;
        u8[16] a;
        u8[16] b;
        for i32 i = 0; i < 16; i++ { pt_in[i] = cast(u8, (v + i * 17) & 0xff); }
        cf_aes_init(&ctx, &fips_key[0], 16);
        cf_aes_encrypt(&ctx, &pt_in[0], &a[0]);
        ref_encrypt(&fips_key[0], 16, &pt_in[0], &b[0]);
        check(same(&a[0], &b[0], 16), "every byte value, every position");
    }

    // 5. GCM above it
    cf_aes_init(&ctx, &gcm_key[0], 16);
    u8[60] ct;
    u8[16] tag;
    cf_gcm_encrypt(&cf_aes, cast(void*, &ctx), &gcm_pt[0], 60, &gcm_aad[0], 20, &gcm_iv[0], 12, &ct[0], &tag[0], 16);
    check(same(&ct[0], &gcm_ct[0], 60), "GCM test case 4: ciphertext");
    check(same(&tag[0], &gcm_tag[0], 16), "GCM test case 4: tag");
    if !same(&tag[0], &gcm_tag[0], 16) {
        eprint("  library tag:");
        for i32 i = 0; i < 16; i++ { eprint(" {}", cast(i32, tag[i])); }
        eprint("
");
    }

    if fails == 0 { print("aes_ct ok\n"); return 0; }
    eprint("aes_ct: {} failures\n", fails);
    return 1;
}
