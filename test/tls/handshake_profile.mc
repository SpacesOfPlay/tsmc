// handshake_profile.mc -- where a TLS 1.3 handshake spends its time, on
// the host. The server side is the runtime's own: tls_server_ctx_new with
// a P-256 certificate, tls_server_session_new, the same code the unikernel
// runs. The client does not check the chain but does verify the signature,
// as a browser would. Client and server are joined by buffer handoff, so
// there is no network and no runtime in the way.
//
//   minc run test/tls/handshake_profile.mc       the phases, in microseconds
//   minc profile test/tls/handshake_profile.mc   the functions, by share
//
// The phase that is the server's cost on a live handshake is B: it takes
// the ClientHello and produces the whole server flight -- key share,
// signature, and the encrypted records that carry the certificate.

@utf8_console

import "../../src/tls_native.mc";

u8[407] CERT_DER = {
    0x30, 0x82, 0x01, 0x93, 0x30, 0x82, 0x01, 0x39, 0xa0, 0x03, 0x02, 0x01, 0x02, 0x02, 0x14, 0x64,
    0xd3, 0x2c, 0x03, 0x8d, 0x5f, 0xa2, 0x9a, 0x3a, 0x80, 0x86, 0x34, 0x20, 0x95, 0x7b, 0xff, 0x57,
    0xf5, 0xcf, 0xec, 0x30, 0x0a, 0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x04, 0x03, 0x02, 0x30,
    0x17, 0x31, 0x15, 0x30, 0x13, 0x06, 0x03, 0x55, 0x04, 0x03, 0x0c, 0x0c, 0x6d, 0x69, 0x6e, 0x63,
    0x20, 0x74, 0x65, 0x73, 0x74, 0x20, 0x45, 0x36, 0x30, 0x20, 0x17, 0x0d, 0x32, 0x36, 0x30, 0x39,
    0x32, 0x31, 0x30, 0x37, 0x34, 0x34, 0x31, 0x34, 0x5a, 0x18, 0x0f, 0x32, 0x31, 0x32, 0x36, 0x30,
    0x38, 0x32, 0x38, 0x30, 0x37, 0x34, 0x34, 0x31, 0x34, 0x5a, 0x30, 0x18, 0x31, 0x16, 0x30, 0x14,
    0x06, 0x03, 0x55, 0x04, 0x03, 0x0c, 0x0d, 0x74, 0x73, 0x6d, 0x63, 0x2e, 0x6d, 0x69, 0x6e, 0x63,
    0x2e, 0x64, 0x65, 0x76, 0x30, 0x59, 0x30, 0x13, 0x06, 0x07, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02,
    0x01, 0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07, 0x03, 0x42, 0x00, 0x04, 0xcb,
    0x8d, 0x62, 0xe6, 0x24, 0x65, 0xcf, 0xbf, 0x76, 0x5c, 0x04, 0x2e, 0x12, 0x5a, 0xe6, 0xd0, 0x86,
    0x38, 0xee, 0xcc, 0x6f, 0x4d, 0x6d, 0x8c, 0xae, 0x17, 0xe4, 0xfc, 0x4d, 0xa7, 0x80, 0x41, 0x24,
    0x04, 0x55, 0x6c, 0xe5, 0x36, 0xeb, 0x2b, 0x01, 0x7f, 0x10, 0xf1, 0x76, 0x08, 0x43, 0x4c, 0x1b,
    0x4e, 0x5a, 0x78, 0xd1, 0x35, 0xfc, 0xa9, 0x58, 0xfc, 0x73, 0x02, 0x07, 0x43, 0x1b, 0xd5, 0xa3,
    0x60, 0x30, 0x5e, 0x30, 0x29, 0x06, 0x03, 0x55, 0x1d, 0x11, 0x04, 0x22, 0x30, 0x20, 0x82, 0x0d,
    0x74, 0x73, 0x6d, 0x63, 0x2e, 0x6d, 0x69, 0x6e, 0x63, 0x2e, 0x64, 0x65, 0x76, 0x82, 0x09, 0x6c,
    0x6f, 0x63, 0x61, 0x6c, 0x68, 0x6f, 0x73, 0x74, 0x87, 0x04, 0x7f, 0x00, 0x00, 0x01, 0x30, 0x0c,
    0x06, 0x03, 0x55, 0x1d, 0x13, 0x01, 0x01, 0xff, 0x04, 0x02, 0x30, 0x00, 0x30, 0x0e, 0x06, 0x03,
    0x55, 0x1d, 0x0f, 0x01, 0x01, 0xff, 0x04, 0x04, 0x03, 0x02, 0x07, 0x80, 0x30, 0x13, 0x06, 0x03,
    0x55, 0x1d, 0x25, 0x04, 0x0c, 0x30, 0x0a, 0x06, 0x08, 0x2b, 0x06, 0x01, 0x05, 0x05, 0x07, 0x03,
    0x01, 0x30, 0x0a, 0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x04, 0x03, 0x02, 0x03, 0x48, 0x00,
    0x30, 0x45, 0x02, 0x21, 0x00, 0xb3, 0x22, 0x3c, 0x1b, 0xb8, 0x84, 0x6a, 0xf3, 0x1e, 0xfb, 0x6f,
    0xfc, 0xb4, 0x02, 0xa8, 0xa4, 0x0b, 0x98, 0xfc, 0xa3, 0x6d, 0x6d, 0x58, 0xb4, 0x9c, 0x00, 0x74,
    0x4e, 0x9a, 0x96, 0xe5, 0x15, 0x02, 0x20, 0x01, 0xe3, 0x1e, 0x8a, 0xc6, 0x44, 0x0f, 0xa7, 0x44,
    0x7c, 0xce, 0x58, 0xbd, 0xc3, 0xb3, 0x21, 0x22, 0x49, 0xc1, 0x9d, 0x18, 0x59, 0x0a, 0xa2, 0xbf,
    0x9a, 0x59, 0xab, 0xca, 0x02, 0x34, 0x49,
};

u8[121] KEY_DER = {
    0x30, 0x77, 0x02, 0x01, 0x01, 0x04, 0x20, 0x75, 0x87, 0x83, 0x97, 0x89, 0xe7, 0xb1, 0x4e, 0x20,
    0x83, 0x5d, 0x97, 0x53, 0x12, 0x7c, 0xde, 0x82, 0x8d, 0x35, 0x9b, 0x43, 0x1f, 0x9c, 0x91, 0xd4,
    0x42, 0xac, 0x5d, 0x44, 0x6b, 0x96, 0x43, 0xa0, 0x0a, 0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d,
    0x03, 0x01, 0x07, 0xa1, 0x44, 0x03, 0x42, 0x00, 0x04, 0xcb, 0x8d, 0x62, 0xe6, 0x24, 0x65, 0xcf,
    0xbf, 0x76, 0x5c, 0x04, 0x2e, 0x12, 0x5a, 0xe6, 0xd0, 0x86, 0x38, 0xee, 0xcc, 0x6f, 0x4d, 0x6d,
    0x8c, 0xae, 0x17, 0xe4, 0xfc, 0x4d, 0xa7, 0x80, 0x41, 0x24, 0x04, 0x55, 0x6c, 0xe5, 0x36, 0xeb,
    0x2b, 0x01, 0x7f, 0x10, 0xf1, 0x76, 0x08, 0x43, 0x4c, 0x1b, 0x4e, 0x5a, 0x78, 0xd1, 0x35, 0xfc,
    0xa9, 0x58, 0xfc, 0x73, 0x02, 0x07, 0x43, 0x1b, 0xd5,
};

const i32 ROUNDS = 200;
const i32 RECORDS = 1000;

i32 main() {
    i32[1] lens;
    lens[0] = 407;
    i32 ctx = tls_server_ctx_new(&CERT_DER[0], &lens[0], 1, &KEY_DER[0], cast(u64, 121));
    if ctx < 0 { print("no server context from the test certificate
"); return 1; }

    i64 f = qpf();
    i64 ta = 0; i64 tb = 0; i64 tc = 0; i64 td = 0; i64 te = 0; i64 tf = 0;
    i32 done = 0;
    i32 bad = 0;
    for i32 r = 0; r < ROUNDS; r++ {
        TlsSession* srv = tls_server_session_new(ctx);
        TlsSession* cli = tls_session_new("localhost", true);
        if srv == null || cli == null { print("no session
"); return 2; }
        ptls_buffer_t cb; u8[8192] cbs; ptls_buffer_init(&cb, &cbs[0], 8192);
        ptls_buffer_t sb; u8[8192] sbs; ptls_buffer_init(&sb, &sbs[0], 8192);

        u64 n = 0;
        i64 t0 = qpc();
        ignore ptls_handshake(cli.tls, &cb, null, &n, null);                     // A: ClientHello
        i64 t1 = qpc();
        n = cb.off;
        ignore ptls_handshake(srv.tls, &sb, cast(void*, cb.base), &n, null);     // B: the server flight
        i64 t2 = qpc();
        cb.off = 0;
        n = sb.off;
        ignore ptls_handshake(cli.tls, &cb, cast(void*, sb.base), &n, null);     // C: client takes it
        if n < sb.off {
            u64 rem = sb.off - n;
            u8* rest = sb.base + n;
            cb.off = 0;
            u64 n2 = rem;
            ignore ptls_handshake(cli.tls, &cb, cast(void*, rest), &n2, null);
        }
        i64 t3 = qpc();
        if cb.off > 0 {
            u64 n3 = cb.off;
            ignore ptls_handshake(srv.tls, &sb, cast(void*, cb.base), &n3, null); // D: client Finished
        }
        i64 t4 = qpc();
        if ptls_handshake_is_complete(cli.tls) != 0 && ptls_handshake_is_complete(srv.tls) != 0 { done++; }
        ta = ta + (t1 - t0); tb = tb + (t2 - t1); tc = tc + (t3 - t2); td = td + (t4 - t3);
        // E: what a request costs once the connection is up -- the server
        // encrypting a response-sized record, the client decrypting it.
        // On the last round only, so the handshake numbers stay clean.
        if r == ROUNDS - 1 {
            u8[1400] rec;
            for i32 k = 0; k < 1400; k++ { rec[k] = cast(u8, k); }
            ptls_buffer_t ob; u8[2048] obs;
            ptls_buffer_t ib; u8[2048] ibs;
            // Send and receive interleaved: a record is numbered, and one
            // sent while the other side is not listening puts every later
            // one out of step -- which is how a first draft of this showed
            // decryption "ten times faster" by failing every record.
            for i32 k = 0; k < RECORDS; k++ {
                ptls_buffer_init(&ob, &obs[0], 2048);
                i64 t5 = qpc();
                ignore ptls_send(srv.tls, &ob, &rec[0], cast(u64, 1400));
                i64 t6 = qpc();
                ptls_buffer_init(&ib, &ibs[0], 2048);
                u64 inl = ob.off;
                i32 rr = ptls_receive(cli.tls, &ib, cast(void*, ob.base), &inl);
                i64 t7 = qpc();
                if rr != 0 || ib.off != cast(u64, 1400) { bad++; }
                te = te + (t6 - t5); tf = tf + (t7 - t6);
                ptls_buffer_dispose(&ib);
                ptls_buffer_dispose(&ob);
            }
        }
        tls_session_free(cli);
        tls_session_free(srv);
        ptls_buffer_dispose(&cb);
        ptls_buffer_dispose(&sb);
    }
    i64 us = 1000000;
    print("handshakes complete: {} of {}
", done, ROUNDS);
    print("per handshake, microseconds:
");
    print("  A  client: ClientHello (X25519 keygen)                 {}
", ta * us / f / ROUNDS);
    print("  B  SERVER: flight (X25519, ECDSA P-256 sign, records)  {}
", tb * us / f / ROUNDS);
    print("  C  client: verify + Finished (X25519, P-256 verify)    {}
", tc * us / f / ROUNDS);
    print("  D  SERVER: client Finished                             {}
", td * us / f / ROUNDS);
    print("  server total (B + D)                                   {}
", (tb + td) * us / f / ROUNDS);
    print("per 1400-byte record, microseconds:
");
    print("  E  SERVER: encrypt one record                          {}
", te * us / f / RECORDS);
    print("  F  client: decrypt one record                          {}   ({} of {} records failed to decrypt)
", tf * us / f / RECORDS, bad, RECORDS);
    return done == ROUNDS ? 0 : 3;
}
